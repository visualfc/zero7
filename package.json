{
  "name": "zero7",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:cert && concurrently -k -n 网页,灵矽 \"vite --host 0.0.0.0\" \"node server/index.mjs\"",
    "dev:cert": "node scripts/create-dev-cert.mjs",
    "build": "tsc -b && vite build",
    "puzzles:import": "node scripts/import-puzzles.mjs",
    "puzzles:import:chessdb": "node scripts/import-chessdb-verifications.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run && node --test server/*.node-test.mjs",
    "dev:web": "vite",
    "dev:bridge": "node server/index.mjs",
    "start": "node server/index.mjs",
    "test:coverage": "vitest run --coverage && node --test server/*.node-test.mjs"
  },
  "dependencies": {
    "@weshell/xiangqi.js": "^1.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "pinyin-pro": "^3.29.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "description": "ZERO7｜面向象棋初学者与普通爱好者的开源 AI 语音象棋伙伴",
  "license": "Apache-2.0"
}
